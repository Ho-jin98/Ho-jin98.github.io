---
import FlowConnector from './FlowConnector.astro';
import type { CaseDiagram } from '../../../data/caseStudies/types';

interface Props {
  diagram: Extract<CaseDiagram, { type: 'merge' }>;
  id: string;
}

const { diagram, id } = Astro.props;
---

<section class:list={['case-diagram', 'case-diagram--merge', diagram.density && `case-diagram--${diagram.density}`, diagram.spacingAfter && `case-diagram--spacing-after-${diagram.spacingAfter}`]} aria-labelledby={`${id}-heading`}>
  <h4 id={`${id}-heading`} class="case-diagram__heading">{diagram.label}</h4>
  <div class="merge-flow">
    <div class="merge-flow__sources">
      {diagram.sources.map((source) => (
        <article class="case-flow-node">
          <strong>{source.title}</strong>
          {source.text && <p>{source.text}</p>}
        </article>
      ))}
    </div>
    <FlowConnector variant="merge" density={diagram.density} tone={diagram.connectorTone} ariaLabel={`${diagram.label} 합류 연결선`} />
    <article class="case-flow-node case-flow-node--merge">
      <strong>{diagram.merge.title}</strong>
      {diagram.merge.text && <p>{diagram.merge.text}</p>}
    </article>
    <FlowConnector variant="down" density={diagram.density} tone={diagram.connectorTone} />
    <article class:list={['case-flow-node', 'case-flow-node--result', diagram.result.tone && `is-${diagram.result.tone}`]}>
      <strong>{diagram.result.title}</strong>
      {diagram.result.text && <p>{diagram.result.text}</p>}
    </article>
  </div>
</section>

<style>
  .merge-flow {
    display: grid;
    width: min(100%, 40rem);
    gap: 0.14rem;
    justify-items: center;
    margin-inline: auto;
  }

  .case-diagram--compact .merge-flow {
    width: min(100%, 36rem);
    gap: 0.08rem;
    margin-inline: auto;
  }

  .merge-flow__sources {
    display: grid;
    width: min(100%, 34rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.4rem, 4vw, 4rem);
  }

  .case-diagram--compact .merge-flow__sources {
    width: 100%;
    gap: clamp(1rem, 3vw, 2.8rem);
  }

  .case-flow-node {
    display: grid;
    align-items: center;
    width: min(100%, 13.4rem);
    padding: 0.38rem 0.62rem;
    text-align: center;
  }

  .case-diagram--compact .case-flow-node {
    min-height: 3.45rem;
    padding: 0.5rem 0.7rem;
    background: #f3f8fe;
    box-shadow: 0 0.35rem 0.95rem rgba(41, 65, 112, 0.035);
  }

  .case-flow-node--merge,
  .case-flow-node--result {
    width: min(100%, 18.5rem);
    padding: 0.42rem 0.64rem;
  }

  .case-diagram--compact .case-flow-node--merge,
  .case-diagram--compact .case-flow-node--result {
    width: min(100%, 17.5rem);
  }

  @media (max-width: 640px) {
    .merge-flow__sources {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .case-flow-node,
    .case-flow-node--merge,
    .case-flow-node--result {
      width: 100%;
    }
  }
</style>
