---
import FlowConnector from './FlowConnector.astro';
import type { CaseDiagram } from '../../../data/caseStudies/types';

interface Props {
  diagram: Extract<CaseDiagram, { type: 'hub' }>;
  id: string;
}

const { diagram, id } = Astro.props;
---

<section class:list={['case-diagram', 'case-diagram--hub', diagram.density && `case-diagram--${diagram.density}`, diagram.spacingAfter && `case-diagram--spacing-after-${diagram.spacingAfter}`]} aria-labelledby={`${id}-heading`}>
  <h4 id={`${id}-heading`} class="case-diagram__heading">{diagram.label}</h4>
  <div class="hub-flow">
    <div class="hub-flow__sources">
      {diagram.sources.map((source) => (
        <article class="case-flow-node case-flow-node--plain">
          <strong>{source.title}</strong>
          {source.text && <p>{source.text}</p>}
        </article>
      ))}
    </div>
    <FlowConnector variant="hub" density={diagram.density} tone={diagram.connectorTone} ariaLabel={`${diagram.label} 연결선`} />
    <article class:list={['case-flow-node', 'case-flow-node--target', diagram.target.tone && `is-${diagram.target.tone}`]}>
      <strong>{diagram.target.title}</strong>
      {diagram.target.text && <p>{diagram.target.text}</p>}
    </article>
  </div>
</section>

<style>
  .hub-flow {
    display: grid;
    width: min(100%, 56rem);
    gap: 0.18rem;
  }

  .case-diagram--compact .hub-flow {
    width: min(100%, 42.2rem);
    gap: 0.08rem;
  }

  .hub-flow__sources {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3.2vw, 2.8rem);
    align-items: end;
  }

  .case-diagram--compact .hub-flow__sources {
    gap: 0;
  }

  .case-flow-node {
    text-align: center;
  }

  .case-flow-node--plain {
    justify-self: center;
    width: min(100%, 11.8rem);
    padding: 0.06rem 0.12rem;
  }

  .case-diagram--compact .case-flow-node--plain {
    display: grid;
    width: min(100%, 10.2rem);
    min-height: 3.8rem;
    padding: 0.58rem 0.74rem;
    align-content: center;
    border: 1px solid #dfe7f2;
    border-radius: 0.72rem;
    background: #f3f8fe;
    box-shadow: 0 0.35rem 0.95rem rgba(41, 65, 112, 0.035);
  }

  .case-flow-node--target {
    justify-self: center;
    min-width: 12rem;
    padding: 0.54rem 0.84rem;
    box-shadow: 0 0.28rem 0.76rem rgba(47, 125, 211, 0.065);
  }

  .case-diagram--compact .case-flow-node--target {
    min-width: 11.2rem;
    padding-block: 0.52rem;
  }

  @media (max-width: 640px) {
    .hub-flow__sources {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .case-flow-node--plain,
    .case-flow-node--target {
      width: 100%;
    }
  }
</style>
